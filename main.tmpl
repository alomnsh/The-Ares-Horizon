<!doctype html>
<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, minimal-ui">
    <title>The Ares Horizon - Mission Control Terminal</title>
    <style>
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            overflow: hidden; background-color: #0a0c12;
        }
        #canvas {
            display: block; width: 100vw !important; height: 100vh !important;
            margin: 0; padding: 0; border: none;
        }
    </style>
</head>
<body>
    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>
    <script>
        window.config = {
            fb_width: window.innerWidth,
            fb_height: window.innerHeight,
            fb_ar: window.innerWidth / window.innerHeight,
            features: ["vtx", "snd", "gui"]
        };
    </script>
    <script src="https://github.io"></script>
</body>
</html>
